{
  "name": "option-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Sell-put decision-support scanner for a personal HK + US watchlist. Never places orders.",
  "license": "MIT",
  "author": "haijin (https://github.com/haijin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haijin/option-trading.git"
  },
  "bugs": {
    "url": "https://github.com/haijin/option-trading/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "app": "node scripts/run-app.mjs",
    "app:server": "tsx src/server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "demo": "node scripts/demo.mjs",
    "web:build": "vite build --config web/vite.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-strike": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "futu-api": "10.11.7108",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "sharp": "^0.35.5",
    "yahoo-finance2": "^4.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

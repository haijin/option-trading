# PostgreSQL 16 (native). The app connects over this URL; db:migrate creates nothing outside this database.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/option_trading
# Admin URL (maintenance database) used only by the test harness to create and drop throwaway databases.
PG_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres
# HKD or USD: currency of `settings set equity` and of all caps.
BASE_CURRENCY=HKD
# Reserved for later phases (not used yet).
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=
# moomoo OpenD (read-only HK daily bars, option chains and IV history). Leave FUTU_PORT empty to run without OpenD.
# FUTU_PORT is the WebSocket port from OpenD.xml (websocket_port), not the TCP API port. FUTU_HOST defaults to 127.0.0.1.
# FUTU_WS_KEY is needed only when OpenD.xml sets websocket_key: put the same plain-text key here.
FUTU_HOST=
FUTU_PORT=
FUTU_WS_KEY=
FMP_API_KEY=

# --- Web app (optional; defaults are shown) ---
# INVEST_AGENT_ROOT=C:\path\to\ai-berkshire   # no default: your clone of ai-berkshire; without it the six prompt-driven research skills are unavailable
# OT_CLAUDE_CLI=C:\Users\you\.local\bin\claude.exe
# OT_PYTHON=C:\Users\you\AppData\Local\Python\bin\python.exe
# OT_SKILL_MAX_BUDGET_USD=5
# OT_SKILL_MODEL=
# OT_SKILL_EXECUTOR=auto
# OT_PORT=3004

# --- Sign-in (the login page) ---
# The app asks for a login. The first account is created on the login page, on the machine that runs the server,
# with the setup code the server prints in its terminal at start-up.
# OT_AUTH=off                  # no login at all; only for a machine nobody else can reach (APP_URL is then ignored)
# APP_URL=https://app.example.com  # public address (tunnel / reverse proxy to 127.0.0.1:3004). Used for emailed links and
#                              # the Google redirect URI, and the only non-loopback Host the server answers on.
# Google sign-in: create an OAuth client (type "Web application") in Google Cloud Console and register these
# redirect URIs: http://127.0.0.1:3004/api/auth/google/callback and ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email links: any SMTP server. Without OT_SMTP_URL the link is printed in the server's terminal instead of mailed.
# OT_SMTP_URL=smtps://user:password@smtp.example.com:465
# OT_MAIL_FROM="Option Trading <login@example.com>"

# Scheduled jobs (daily ingest, chain snapshots, position marks, scan) inside the server, via pg-boss. Off by default.
# OT_JOBS=on
# Push new position alerts (nothing is sent unless one of these is set). Telegram: create a bot with @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Email alerts reuse OT_SMTP_URL and OT_MAIL_FROM above:
# OT_ALERT_EMAIL=you@example.com
